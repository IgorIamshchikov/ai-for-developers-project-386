#!/bin/bash -e

# If running the rails server with a database configured, create or migrate it.
# Без $DATABASE_URL (например, в автопроверке Хекслета, где задан только $PORT) пропускаем —
# иначе контейнер не стартует без Postgres.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ] && [ -n "$DATABASE_URL" ]; then
  ./bin/rails db:prepare
fi

# Hosting platforms (Render, Railway, ...) inject $PORT and expect the
# container to listen on it. Thruster listens on $HTTP_PORT (default 80),
# not $PORT (which it instead sets for the Puma child process), so map it.
if [ -n "$PORT" ]; then
  export HTTP_PORT="$PORT"
fi

exec "${@}"
